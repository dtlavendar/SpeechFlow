---
const title = "Download SpeechFlow";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Download SpeechFlow — system-wide dictation with linked notes. macOS." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="grain"></div>
  <div class="radial-glow"></div>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">SpeechFlow</a>
      <div class="nav-links">
        <a href="https://github.com/speechflow">GitHub</a>
        <a href="/" class="nav-back">&larr; Home</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="dl-hero">
      <h1 class="reveal reveal-1">Download SpeechFlow</h1>
      <p class="dl-hero-sub reveal reveal-2">Free. Open source. Runs entirely on your machine.</p>
    </section>

    <section class="platforms">
      <div class="platform-card primary reveal reveal-3">
        <div class="platform-badge">Recommended</div>
        <div class="platform-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 22C7.79 22.05 6.8 20.68 5.96 19.47C4.25 16.94 2.94 12.33 4.7 9.21C5.57 7.67 7.14 6.69 8.86 6.67C10.14 6.65 11.36 7.54 12.15 7.54C12.94 7.54 14.43 6.47 15.95 6.63C16.61 6.66 18.4 6.9 19.56 8.56C19.47 8.62 17.26 9.92 17.29 12.59C17.32 15.8 20.07 16.84 20.1 16.85C20.07 16.93 19.67 18.34 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" /></svg>
        </div>
        <h2>macOS</h2>
        <p class="platform-arch">Universal — Apple Silicon & Intel</p>
        <a href="#" class="platform-dl-btn">
          <span class="btn-shimmer"></span>
          Download .dmg
        </a>
        <span class="platform-version">v0.1.0 &middot; 42 MB</span>
        <div class="platform-extras">
          <a href="#">Homebrew: <code>brew install speechflow</code></a>
        </div>
      </div>

      <div class="platform-card secondary reveal reveal-4">
        <div class="platform-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801" /></svg>
        </div>
        <h2>Windows</h2>
        <p class="platform-arch">x64 & ARM64</p>
        <div class="platform-soon">Coming soon</div>
        <span class="platform-version">Join the waitlist on GitHub</span>
      </div>

      <div class="platform-card secondary reveal reveal-5">
        <div class="platform-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M12.504 0c-.155 0-.311.002-.464.006a19.52 19.52 0 00-4.147.603c-2.21.592-3.284 1.47-3.284 1.47s1.164-.48 3.153-.864c-.046.011-.088.026-.134.038v.271c-1.335.479-2.535 1.135-3.555 1.855a7.075 7.075 0 00-1.048.807c-.083.078-.156.157-.226.238A11.048 11.048 0 00.85 8.681C.292 10.074 0 11.624 0 13.28c0 1.064.13 2.048.365 2.93.366 1.365.955 2.47 1.627 3.312.671.842 1.42 1.414 2.053 1.779.633.365 1.139.553 1.484.653.346.1.53.134.53.134l-.018-.04a.907.907 0 01-.047-.104c0-.001 0-.003-.002-.004-.18-.42-.393-1.148-.537-2.14a10.28 10.28 0 01-.038-.476c-.02-.267-.032-.547-.032-.839 0-1.208.218-2.333.607-3.341a9.878 9.878 0 011.565-2.698c.614-.738 1.311-1.353 2.046-1.825a10.032 10.032 0 012.313-1.2 7.07 7.07 0 012.114-.498c.346-.035.688-.05 1.025-.05.337 0 .679.015 1.025.05a7.07 7.07 0 012.114.498 10.032 10.032 0 012.313 1.2c.735.472 1.432 1.087 2.046 1.825a9.878 9.878 0 011.565 2.698c.389 1.008.607 2.133.607 3.341 0 .292-.012.572-.032.839-.011.16-.024.32-.038.476-.144.992-.357 1.72-.537 2.14-.002.001-.002.003-.002.004a.907.907 0 01-.047.104l-.018.04s.184-.034.53-.134c.345-.1.851-.288 1.484-.653.633-.365 1.382-.937 2.053-1.779.672-.842 1.261-1.947 1.627-3.312.235-.882.365-1.866.365-2.93 0-1.656-.292-3.206-.85-4.599A11.048 11.048 0 0021.12 4.424c-.07-.081-.143-.16-.226-.238a7.075 7.075 0 00-1.048-.807c-1.02-.72-2.22-1.376-3.555-1.855V1.253c-.046-.012-.088-.027-.134-.038 1.989.384 3.153.864 3.153.864s-1.074-.878-3.284-1.47a19.52 19.52 0 00-4.147-.603A7.388 7.388 0 0012.504 0zM8.93 10.88a2 2 0 00-1.928 1.42c-.17.45-.17.94 0 1.4a2 2 0 001.928 1.42c.53 0 1.03-.21 1.4-.6a2 2 0 00.528-1.42 2 2 0 00-.528-1.4 1.96 1.96 0 00-1.4-.82zm6.14 0c-.53 0-1.03.3-1.4.82a2 2 0 00-.528 1.4c0 .53.19 1.03.528 1.42.37.39.87.6 1.4.6a2 2 0 001.928-1.42c.17-.46.17-.95 0-1.4a2 2 0 00-1.928-1.42z" /></svg>
        </div>
        <h2>Linux</h2>
        <p class="platform-arch">x64 & ARM64</p>
        <div class="platform-soon">Coming soon</div>
        <span class="platform-version">Join the waitlist on GitHub</span>
      </div>
    </section>

    <section class="build-source reveal reveal-6">
      <h3>Build from source</h3>
      <div class="code-block">
        <code>git clone https://github.com/speechflow/speechflow.git<br />cd speechflow<br />swift build -c release</code>
      </div>
      <p>Requires Swift 5.9+ and macOS 14+. See the <a href="https://github.com/speechflow/blob/main/CONTRIBUTING.md">contributing guide</a> for details.</p>
    </section>

    <section class="checksums reveal reveal-7">
      <h3>Verify your download</h3>
      <p>Compare the SHA-256 checksum of your downloaded file against the published checksum on the <a href="https://github.com/speechflow/releases">releases page</a>.</p>
      <div class="code-block">
        <code>shasum -a 256 SpeechFlow-0.1.0.dmg</code>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <span class="footer-name">SpeechFlow</span>
      <div class="footer-links">
        <a href="https://github.com/speechflow">GitHub</a>
        <a href="#">License</a>
      </div>
    </div>
  </footer>

  <style>
    :root {
      --bg: #0a0a0f;
      --bg-surface: #111118;
      --bg-elevated: #1a1a24;
      --text: #e8e6e3;
      --text-body: #a8a4a0;
      --text-dim: #6e6a66;
      --accent: #c4a0ff;
      --accent-light: #dfc4ff;
      --accent-dim: rgba(196, 160, 255, 0.08);
      --accent-glow: rgba(196, 160, 255, 0.12);
      --accent-hover: #b48ef5;
      --border: rgba(255, 255, 255, 0.06);
      --border-light: rgba(255, 255, 255, 0.04);
      --serif: 'Instrument Serif', Georgia, serif;
      --sans: 'Figtree', -apple-system, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--bg); }

    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      line-height: 1.7;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--accent-light); }

    code {
      font-family: 'Menlo', monospace;
      font-size: 0.82em;
    }

    .grain {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      pointer-events: none;
      z-index: 500;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 200px 200px;
    }

    .radial-glow {
      position: fixed;
      top: -20vh; left: 50%;
      transform: translateX(-50%);
      width: 120vw; height: 80vh;
      background: radial-gradient(
        ellipse at 50% 30%,
        rgba(196, 160, 255, 0.06) 0%,
        rgba(196, 160, 255, 0.02) 40%,
        transparent 70%
      );
      pointer-events: none;
      z-index: 0;
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      animation: revealUp 0.7s ease-out forwards;
    }
    @keyframes revealUp {
      to { opacity: 1; transform: translateY(0); }
    }
    .reveal-1 { animation-delay: 0.1s; }
    .reveal-2 { animation-delay: 0.2s; }
    .reveal-3 { animation-delay: 0.3s; }
    .reveal-4 { animation-delay: 0.4s; }
    .reveal-5 { animation-delay: 0.5s; }
    .reveal-6 { animation-delay: 0.55s; }
    .reveal-7 { animation-delay: 0.6s; }

    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(10, 10, 15, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner {
      max-width: 860px;
      margin: 0 auto;
      padding: 14px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: var(--serif);
      font-size: 22px;
      color: var(--text);
      letter-spacing: -0.3px;
    }
    .nav-links { display: flex; gap: 20px; align-items: center; }
    .nav-links a { color: var(--text-dim); font-size: 14px; font-weight: 500; }
    .nav-links a:hover { color: var(--text); }
    .nav-back { color: var(--text-dim); }

    main { position: relative; z-index: 1; }

    .dl-hero {
      max-width: 860px;
      margin: 0 auto;
      padding: 140px 32px 48px;
      text-align: center;
    }
    .dl-hero h1 {
      font-family: var(--serif);
      font-size: clamp(36px, 6vw, 52px);
      font-weight: 400;
      line-height: 1.15;
      margin-bottom: 12px;
    }
    .dl-hero-sub {
      font-size: 18px;
      color: var(--text-body);
      font-weight: 300;
    }

    .platforms {
      max-width: 860px;
      margin: 0 auto;
      padding: 32px 32px 64px;
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 16px;
      align-items: start;
    }
    .platform-card {
      position: relative;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 32px 24px;
      text-align: center;
      transition: all 0.3s;
    }
    .platform-card.primary {
      border-color: rgba(196, 160, 255, 0.15);
      box-shadow: 0 4px 32px rgba(196, 160, 255, 0.04);
    }
    .platform-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 40px rgba(196, 160, 255, 0.06);
    }
    .platform-badge {
      position: absolute;
      top: -10px; left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: var(--bg);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 3px 14px;
      border-radius: 20px;
    }
    .platform-icon {
      color: var(--accent);
      margin-bottom: 16px;
      opacity: 0.7;
    }
    .platform-card h2 {
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 400;
      margin-bottom: 4px;
    }
    .platform-arch {
      font-size: 13px;
      color: var(--text-dim);
      margin-bottom: 20px;
    }
    .platform-dl-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: var(--bg);
      padding: 12px 32px;
      border-radius: 8px;
      font-family: var(--sans);
      font-size: 15px;
      font-weight: 600;
      transition: all 0.25s;
      overflow: hidden;
      margin-bottom: 12px;
      width: 100%;
    }
    .platform-dl-btn:hover {
      background: var(--accent-light);
      color: var(--bg);
      transform: translateY(-1px);
      box-shadow: 0 6px 28px rgba(196, 160, 255, 0.2);
    }
    .btn-shimmer {
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
      animation: shimmer 3s ease-in-out infinite;
    }
    @keyframes shimmer {
      0% { left: -100%; }
      50% { left: 100%; }
      100% { left: 100%; }
    }
    .platform-soon {
      display: inline-block;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      color: var(--text-dim);
      padding: 10px 28px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 12px;
    }
    .platform-version {
      font-size: 12px;
      color: var(--text-dim);
    }
    .platform-extras {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }
    .platform-extras a {
      font-size: 13px;
      color: var(--text-dim);
    }
    .platform-extras code {
      background: var(--bg-elevated);
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid var(--border);
      color: var(--accent);
    }

    .build-source, .checksums {
      max-width: 860px;
      margin: 0 auto;
      padding: 40px 32px;
    }
    .build-source {
      border-top: 1px solid var(--border);
      padding-top: 56px;
    }
    .checksums {
      padding-bottom: 80px;
    }
    .build-source h3, .checksums h3 {
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 400;
      margin-bottom: 16px;
    }
    .build-source p, .checksums p {
      font-size: 14px;
      color: var(--text-body);
      line-height: 1.7;
      margin-top: 12px;
    }

    .code-block {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px 20px;
      overflow-x: auto;
    }
    .code-block code {
      font-size: 13px;
      color: var(--accent);
      background: none;
      border: none;
      padding: 0;
      line-height: 1.8;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 24px 32px;
    }
    .footer-inner {
      max-width: 860px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-name {
      font-family: var(--serif);
      font-size: 16px;
      color: var(--text-dim);
    }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { font-size: 13px; color: var(--text-dim); }
    .footer-links a:hover { color: var(--accent); }

    @media (max-width: 640px) {
      .platforms {
        grid-template-columns: 1fr;
      }
    }
  </style>
</body>
</html>
