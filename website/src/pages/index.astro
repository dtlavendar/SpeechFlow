---
const title = "SpeechFlow — Speak, link, remember.";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Open-source system-wide dictation that builds linked notes. Local AI. macOS." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="grain"></div>
  <div class="radial-glow"></div>
  <canvas id="graph-canvas"></canvas>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">SpeechFlow</a>
      <div class="nav-links">
        <a href="https://github.com/speechflow">GitHub</a>
        <a href="/download" class="nav-cta">Download</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero">
      <h1 class="reveal reveal-1">
        Speak, <em>link,</em> remember.
      </h1>
      <p class="hero-sub reveal reveal-2">
        Open-source system-wide dictation that builds a vault of linked notes.
      </p>
      <div class="hero-actions reveal reveal-3">
        <a href="/download" class="btn-primary">
          <span class="btn-shimmer"></span>
          Download for macOS
        </a>
        <a href="/download" class="btn-text">More platforms</a>
      </div>
    </section>

    <section class="values">
      <div class="value reveal reveal-4">
        <p><strong>Your voice stays local.</strong> SpeechFlow runs inference entirely on your device. No cloud calls, no accounts, no data leaves your machine.</p>
      </div>
      <div class="value reveal reveal-5">
        <p><strong>Your notes are yours.</strong> Markdown files with wikilinks, stored on disk. No proprietary format, no lock-in. Export everything, always.</p>
      </div>
      <div class="value reveal reveal-6">
        <p><strong>Your tools are auditable.</strong> Fully open source. Every connector, adapter, and vault operation ships in the repo. Inspect, fork, extend.</p>
      </div>
      <div class="value-cta reveal reveal-7">
        <p>Free and open source. <a href="/download">Download now</a></p>
      </div>
    </section>

    <section class="features">
      <h2 class="reveal reveal-f1">Capture and connect.</h2>
      <p class="features-sub reveal reveal-f2">
        From lecture halls to late-night study sessions, SpeechFlow turns spoken ideas into structured knowledge.
      </p>

      <div class="features-grid">
        <div class="feature reveal reveal-f3">
          <h3>Dictation</h3>
          <p>System-wide voice input in any application. Local ASR transcribes, you preview before inserting. Speak anywhere you can type.</p>
        </div>
        <div class="feature reveal reveal-f4">
          <h3>Linked notes</h3>
          <p>Atomic notes connected by [[wikilinks]]. Assignments, readings, and ideas form a navigable graph&mdash;not a single long document.</p>
        </div>
        <div class="feature reveal reveal-f5">
          <h3>Course connectors</h3>
          <p>Pull assignments, announcements, and readings from Canvas into your vault. Structured metadata, not bulk content.</p>
        </div>
        <div class="feature reveal reveal-f6">
          <h3>Local inference</h3>
          <p>Swap model backends freely&mdash;GGUF, Core ML, local servers. The <code>InferenceBackend</code> protocol is the only contract.</p>
        </div>
      </div>
    </section>

    <section id="download" class="download-section">
      <h2 class="reveal reveal-d1">Get started.</h2>
      <div class="download-options reveal reveal-d2">
        <a href="/download" class="download-btn">
          <span class="dl-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
          </span>
          <span class="dl-details">
            <span class="dl-label">Download for macOS</span>
            <span class="dl-meta">Apple Silicon & Intel &middot; Free</span>
          </span>
        </a>
      </div>
      <p class="dl-source reveal reveal-d3">Or build from source: <code>git clone && swift build</code></p>
    </section>

    <section class="community">
      <h2 class="reveal reveal-c1">Join the project.</h2>
      <div class="community-grid">
        <a href="https://github.com/speechflow" class="community-link reveal reveal-c2">
          <h3>Source code</h3>
          <p>Browse the repo, open issues, submit pull requests.</p>
        </a>
        <a href="https://github.com/speechflow/discussions" class="community-link reveal reveal-c3">
          <h3>Discussions</h3>
          <p>Feature requests, questions, and knowledge management ideas.</p>
        </a>
        <a href="https://github.com/speechflow/blob/main/CONTRIBUTING.md" class="community-link reveal reveal-c4">
          <h3>Contribute</h3>
          <p>Connectors, inference backends, vault improvements, dictation UX.</p>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <span class="footer-name">SpeechFlow</span>
      <div class="footer-links">
        <a href="https://github.com/speechflow">GitHub</a>
        <a href="#">License</a>
      </div>
    </div>
  </footer>

  <style>
    :root {
      --bg: #0a0a0f;
      --bg-surface: #111118;
      --bg-elevated: #1a1a24;
      --text: #e8e6e3;
      --text-body: #a8a4a0;
      --text-dim: #6e6a66;
      --accent: #c4a0ff;
      --accent-light: #dfc4ff;
      --accent-dim: rgba(196, 160, 255, 0.08);
      --accent-glow: rgba(196, 160, 255, 0.12);
      --accent-hover: #b48ef5;
      --border: rgba(255, 255, 255, 0.06);
      --border-light: rgba(255, 255, 255, 0.04);
      --serif: 'Instrument Serif', Georgia, serif;
      --sans: 'Figtree', -apple-system, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--bg); }

    body {
      font-family: var(--sans);
      color: var(--text);
      background: var(--bg);
      line-height: 1.7;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--accent-light); }

    code {
      font-family: 'Menlo', monospace;
      font-size: 0.82em;
      background: var(--bg-elevated);
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid var(--border);
    }

    /* --- ATMOSPHERE --- */
    .grain {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      pointer-events: none;
      z-index: 500;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 200px 200px;
    }

    .radial-glow {
      position: fixed;
      top: -20vh; left: 50%;
      transform: translateX(-50%);
      width: 120vw; height: 80vh;
      background: radial-gradient(
        ellipse at 50% 30%,
        rgba(196, 160, 255, 0.06) 0%,
        rgba(196, 160, 255, 0.02) 40%,
        transparent 70%
      );
      pointer-events: none;
      z-index: 0;
    }

    #graph-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 0;
      opacity: 0.35;
    }

    /* --- REVEAL ANIMATIONS --- */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      animation: revealUp 0.7s ease-out forwards;
    }
    @keyframes revealUp {
      to { opacity: 1; transform: translateY(0); }
    }
    .reveal-1 { animation-delay: 0.1s; }
    .reveal-2 { animation-delay: 0.25s; }
    .reveal-3 { animation-delay: 0.4s; }
    .reveal-4 { animation-delay: 0.55s; }
    .reveal-5 { animation-delay: 0.65s; }
    .reveal-6 { animation-delay: 0.75s; }
    .reveal-7 { animation-delay: 0.85s; }
    .reveal-f1 { animation-delay: 0.1s; }
    .reveal-f2 { animation-delay: 0.2s; }
    .reveal-f3 { animation-delay: 0.3s; }
    .reveal-f4 { animation-delay: 0.4s; }
    .reveal-f5 { animation-delay: 0.5s; }
    .reveal-f6 { animation-delay: 0.6s; }
    .reveal-d1 { animation-delay: 0.1s; }
    .reveal-d2 { animation-delay: 0.2s; }
    .reveal-d3 { animation-delay: 0.3s; }
    .reveal-c1 { animation-delay: 0.1s; }
    .reveal-c2 { animation-delay: 0.2s; }
    .reveal-c3 { animation-delay: 0.3s; }
    .reveal-c4 { animation-delay: 0.4s; }

    /* --- NAV --- */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(10, 10, 15, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner {
      max-width: 780px;
      margin: 0 auto;
      padding: 14px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: var(--serif);
      font-size: 22px;
      color: var(--text);
      letter-spacing: -0.3px;
    }
    .nav-links { display: flex; gap: 20px; align-items: center; }
    .nav-links a { color: var(--text-dim); font-size: 14px; font-weight: 500; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--accent-dim) !important;
      border: 1px solid rgba(196, 160, 255, 0.25);
      color: var(--accent) !important;
      padding: 6px 18px;
      border-radius: 6px;
      font-weight: 600 !important;
    }
    .nav-cta:hover { background: rgba(196, 160, 255, 0.15) !important; }

    main { position: relative; z-index: 1; }

    /* --- HERO --- */
    .hero {
      max-width: 780px;
      margin: 0 auto;
      padding: 150px 32px 48px;
      text-align: center;
    }
    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(40px, 7vw, 64px);
      font-weight: 400;
      line-height: 1.15;
      color: var(--text);
      margin-bottom: 18px;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--accent);
      text-shadow:
        0 0 30px rgba(196, 160, 255, 0.25),
        0 0 60px rgba(196, 160, 255, 0.08);
    }
    .hero-sub {
      font-size: 18px;
      color: var(--text-body);
      max-width: 480px;
      margin: 0 auto 32px;
      line-height: 1.6;
      font-weight: 300;
    }
    .hero-actions {
      display: flex;
      gap: 18px;
      justify-content: center;
      align-items: center;
    }

    .btn-primary {
      position: relative;
      display: inline-flex;
      align-items: center;
      background: var(--accent);
      color: var(--bg);
      padding: 13px 30px;
      border-radius: 8px;
      font-family: var(--sans);
      font-size: 15px;
      font-weight: 600;
      transition: all 0.25s;
      overflow: hidden;
    }
    .btn-primary:hover {
      background: var(--accent-light);
      color: var(--bg);
      transform: translateY(-2px);
      box-shadow: 0 6px 28px rgba(196, 160, 255, 0.2);
    }
    .btn-shimmer {
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.15),
        transparent
      );
      animation: shimmer 3s ease-in-out infinite;
    }
    @keyframes shimmer {
      0% { left: -100%; }
      50% { left: 100%; }
      100% { left: 100%; }
    }

    .btn-text {
      color: var(--text-dim);
      font-size: 15px;
      font-weight: 500;
      transition: color 0.2s;
    }
    .btn-text:hover { color: var(--accent); }

    /* --- VALUE PROPS --- */
    .values {
      max-width: 560px;
      margin: 0 auto;
      padding: 48px 32px 64px;
    }
    .value { padding: 18px 0; }
    .value p {
      font-size: 16px;
      color: var(--text-body);
      line-height: 1.75;
    }
    .value strong {
      color: var(--accent);
      font-weight: 600;
    }
    .value-cta { padding-top: 24px; }
    .value-cta p {
      font-size: 16px;
      color: var(--text);
      font-weight: 500;
    }

    /* --- FEATURES --- */
    .features {
      max-width: 780px;
      margin: 0 auto;
      padding: 72px 32px 88px;
      border-top: 1px solid var(--border);
    }
    .features h2 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 400;
      margin-bottom: 10px;
    }
    .features-sub {
      font-size: 16px;
      color: var(--text-body);
      margin-bottom: 44px;
      max-width: 520px;
      font-weight: 300;
    }
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .feature {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px 24px;
      transition: all 0.3s;
    }
    .feature:hover {
      border-color: rgba(196, 160, 255, 0.15);
      box-shadow: 0 4px 32px rgba(196, 160, 255, 0.06);
      transform: translateY(-3px);
    }
    .feature h3 {
      font-family: var(--serif);
      font-size: 21px;
      font-weight: 400;
      margin-bottom: 8px;
      color: var(--text);
    }
    .feature p {
      font-size: 14px;
      color: var(--text-body);
      line-height: 1.7;
      font-weight: 300;
    }

    /* --- DOWNLOAD --- */
    .download-section {
      max-width: 780px;
      margin: 0 auto;
      padding: 72px 32px 88px;
      border-top: 1px solid var(--border);
    }
    .download-section h2 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 400;
      margin-bottom: 24px;
    }
    .download-options { margin-bottom: 16px; }
    .download-btn {
      display: inline-flex;
      align-items: center;
      gap: 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 32px;
      color: var(--text);
      transition: all 0.3s;
    }
    .download-btn:hover {
      border-color: rgba(196, 160, 255, 0.2);
      box-shadow:
        0 4px 24px var(--accent-glow),
        0 0 0 1px rgba(196, 160, 255, 0.08);
      transform: translateY(-2px);
      color: var(--text);
    }
    .dl-icon {
      color: var(--accent);
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .dl-details {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .dl-label {
      font-size: 16px;
      font-weight: 600;
    }
    .dl-meta {
      font-size: 13px;
      color: var(--text-dim);
      margin-top: 2px;
    }
    .dl-source {
      font-size: 13px;
      color: var(--text-dim);
      margin-top: 14px;
    }

    /* --- COMMUNITY --- */
    .community {
      max-width: 780px;
      margin: 0 auto;
      padding: 72px 32px 88px;
      border-top: 1px solid var(--border);
    }
    .community h2 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 400;
      margin-bottom: 24px;
    }
    .community-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .community-link {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px 20px;
      color: var(--text);
      transition: all 0.3s;
    }
    .community-link:hover {
      border-color: rgba(196, 160, 255, 0.15);
      transform: translateY(-3px);
      box-shadow: 0 6px 28px rgba(0, 0, 0, 0.35);
      color: var(--text);
    }
    .community-link h3 {
      font-family: var(--serif);
      font-size: 19px;
      font-weight: 400;
      margin-bottom: 6px;
    }
    .community-link p {
      font-size: 13px;
      color: var(--text-dim);
      line-height: 1.6;
      font-weight: 300;
    }

    /* --- FOOTER --- */
    footer {
      border-top: 1px solid var(--border);
      padding: 24px 32px;
    }
    .footer-inner {
      max-width: 780px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-name {
      font-family: var(--serif);
      font-size: 16px;
      color: var(--text-dim);
    }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { font-size: 13px; color: var(--text-dim); }
    .footer-links a:hover { color: var(--accent); }

    @media (max-width: 640px) {
      .hero-actions { flex-direction: column; align-items: center; }
      .features-grid { grid-template-columns: 1fr; }
      .community-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script lang="ts">
    const canvas = document.getElementById('graph-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let particles: { x: number; y: number; vx: number; vy: number; size: number }[] = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    for (let i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        size: Math.random() * 2 + 0.5
      });
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(196, 160, 255, 0.3)';
        ctx.fill();
      }

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 150) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(196, 160, 255, ${0.08 * (1 - dist / 150)})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(draw);
    }
    draw();
  </script>
</body>
</html>
